generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  phone                  String?              @unique
  name                   String?
  role                   UserRole             @default(CUSTOMER)
  password               String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  dealerId               String?
  auctions               Auction[]            @relation("seller")
  auditLogs              AuditLog[]
  bids                   Bid[]
  blogPosts              BlogPost[]
  financeApplications    FinanceApplication[]
  importQuotes           ImportQuote[]
  inspectionReports      InspectionReport[]
  notifications          Notification[]
  payments               Payment[]
  sessions               Session[]
  passwordResets         PasswordReset[]
  supportMessages        SupportMessage[]
  assignedSupportTickets SupportTicket[]      @relation("assignedSupport")
  supportTickets         SupportTicket[]
  dealer                 Dealer?              @relation(fields: [dealerId], references: [id])
  rentalBookings         RentalBooking[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Dealer {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  contactName  String?
  contactPhone String?
  address      String?
  createdAt    DateTime  @default(now())
  users        User[]
  vehicles     Vehicle[]
}

model Vehicle {
  id                  String               @id @default(cuid())
  vin                 String               @unique
  make                String
  model               String
  trim                String?
  year                Int
  mileage             Int?
  condition           VehicleCondition     @default(USED)
  color               String?
  transmission        String?
  engine              String?
  description         String?
  dealerId            String
  brandId             String?
  categoryId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  index_vin           String?              @map("vin_index")
  auctions            Auction[]
  financeApplications FinanceApplication[]
  inspections         InspectionReport[]
  shipments           Shipment[]
  brand               Brand?               @relation(fields: [brandId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  dealer              Dealer               @relation(fields: [dealerId], references: [id])
  images              VehicleImage[]
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  publicId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Auction {
  id            String        @id @default(cuid())
  title         String
  description   String?
  vehicleId     String
  sellerId      String
  startingPrice Float
  reservePrice  Float?
  currentPrice  Float?
  startAt       DateTime
  endAt         DateTime
  status        AuctionStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  seller        User          @relation("seller", fields: [sellerId], references: [id])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  bids          Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Float
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id])
  bidder    User     @relation(fields: [bidderId], references: [id])
}

model FinanceApplication {
  id           String   @id @default(cuid())
  userId       String
  vehicleId    String?
  amount       Float
  termMonths   Int
  status       String
  providerData Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amount      Float
  currency    String        @default("USD")
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  metadata    Json?
  rentalBookingId String?
  orderId     String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  rentalBooking RentalBooking? @relation(fields: [rentalBookingId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
}

model Shipment {
  id           String         @id @default(cuid())
  bookingRef   String?        @unique
  carrier      String?
  containerNo  String?
  status       ShipmentStatus @default(CREATED)
  origin       String?
  destination  String?
  eta          DateTime?
  vehicleId    String?
  trackingMeta Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  vehicle      Vehicle?       @relation(fields: [vehicleId], references: [id])
}

model InspectionReport {
  id          String   @id @default(cuid())
  vehicleId   String
  inspectorId String
  photos      Json?
  notes       String?
  score       Int?
  createdAt   DateTime @default(now())
  inspector   User     @relation(fields: [inspectorId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   String
  payload   Json
  read      Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  name        String
  params      Json
  result      Json?
  generatedBy String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String?
  resourceId String?
  payload    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String
  target    String
  rate      Float
  fetchedAt DateTime @default(now())
  source    String?
}

model VinDecodeCache {
  id       String   @id @default(cuid())
  vin      String   @unique
  data     Json
  cachedAt DateTime @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vehicles    Vehicle[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vehicles    Vehicle[]
}

model Page {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  heroText    String?
  content     Json?
  metadata    Json?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?
  content     Json?
  authorId    String?
  publishedAt DateTime?
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  author      User?         @relation(fields: [authorId], references: [id])
}

model SupportTicket {
  id           String           @id @default(cuid())
  userId       String?
  name         String?
  email        String?
  phone        String?
  subject      String
  message      String
  status       SupportStatus    @default(OPEN)
  assignedToId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]
  assignedTo   User?            @relation("assignedSupport", fields: [assignedToId], references: [id])
  user         User?            @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String?
  content   String
  metadata  Json?
  createdAt DateTime      @default(now())
  sender    User?         @relation(fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
}

model ContactInquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  status      SupportStatus @default(OPEN)
  response    String?
  respondedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ImportQuote {
  id           String            @id @default(cuid())
  userId       String?
  origin       String
  destination  String
  vehicleType  String
  priceRange   String
  estimatedFee Float?
  currency     String            @default("USD")
  status       ImportQuoteStatus @default(REQUESTED)
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User?             @relation(fields: [userId], references: [id])
}

// ==================== VEHICLE HIRE SYSTEM ====================
model RentalVehicle {
  id                  String                @id @default(cuid())
  vin                 String                @unique
  make                String
  model               String
  year                Int
  mileage             Int?
  licensePlate        String                @unique
  color               String?
  transmission        String?
  engine              String?
  fuelType            String?
  seatingCapacity     Int?
  status              RentalVehicleStatus   @default(AVAILABLE)
  location            String?
  gpsDeviceId         String?
  description         String?
  basePrice           Float                 // per day
  insuranceIncluded   Boolean               @default(false)
  images              String[]              @default([])
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  bookings            RentalBooking[]
  gpsTracking         GPSTracking[]
  damageReports       DamageReport[]
  pricing             RentalPricing[]
}

model RentalBooking {
  id                  String                @id @default(cuid())
  rentalVehicleId     String
  userId              String
  bookingRef          String                @unique
  pickupDate          DateTime
  returnDate          DateTime
  pickupLocation      String
  returnLocation      String
  status              BookingStatus         @default(PENDING)
  totalPrice          Float
  depositAmount       Float?
  insurancePlanId     String?
  notes               String?
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  vehicle             RentalVehicle         @relation(fields: [rentalVehicleId], references: [id])
  customer            User                  @relation(fields: [userId], references: [id])
  insurance           InsurancePlan?        @relation(fields: [insurancePlanId], references: [id])
  damageReport        DamageReport?
  payments            Payment[]
}

model InsurancePlan {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  coverage            String                // e.g., "Full Coverage", "Basic", "Premium"
  dailyPrice          Float
  maxCoverage         Float
  deductible          Float?
  features            String[]              @default([])
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  bookings            RentalBooking[]
}

model DamageReport {
  id                  String                @id @default(cuid())
  rentalVehicleId     String
  bookingId           String?               @unique
  damageLevel         DamageLevel           @default(MINOR)
  description         String
  location            String?
  photos              String[]              @default([])
  estimatedCost       Float?
  reportedBy          String?               // User ID
  status              String                @default("PENDING")
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  vehicle             RentalVehicle         @relation(fields: [rentalVehicleId], references: [id])
  booking             RentalBooking?        @relation(fields: [bookingId], references: [id])
}

model GPSTracking {
  id                  String                @id @default(cuid())
  rentalVehicleId     String
  latitude            Float
  longitude           Float
  speed               Float?
  heading             Float?
  accuracy            Float?
  timestamp           DateTime
  createdAt           DateTime              @default(now())
  vehicle             RentalVehicle         @relation(fields: [rentalVehicleId], references: [id])

  @@index([rentalVehicleId, timestamp])
}

model RentalPricing {
  id                  String                @id @default(cuid())
  rentalVehicleId     String
  startDate           DateTime
  endDate             DateTime?
  dailyRate           Float
  weeklyRate          Float?
  monthlyRate         Float?
  discountPercentage  Float?
  reason              String?               // e.g., "Seasonal", "Promotion"
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  vehicle             RentalVehicle         @relation(fields: [rentalVehicleId], references: [id])
}

// ==================== AUTO SHOP / SPARE PARTS ====================
model Product {
  id                  String                @id @default(cuid())
  name                String
  sku                 String                @unique
  description         String?
  price               Float
  originalPrice       Float?
  stock               Int                   @default(0)
  categoryId          String
  brandId             String?
  condition           ProductCondition      @default(NEW)
  compatible          String[]              @default([])  // Vehicle makes/models
  images              String[]              @default([])
  specs               Json?
  rating              Float?
  reviews             Review[]
  featured            Boolean               @default(false)
  status              String                @default("ACTIVE")
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  category            ShopCategory          @relation(fields: [categoryId], references: [id])
  cartItems           CartItem[]
  orderItems          OrderItem[]
}

model ShopCategory {
  id                  String                @id @default(cuid())
  name                String                @unique
  slug                String                @unique
  description         String?
  icon                String?
  featured            Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  products            Product[]
}

model Review {
  id                  String                @id @default(cuid())
  productId           String
  userId              String
  rating              Int                   // 1-5
  title               String?
  comment             String?
  photos              String[]              @default([])
  helpful             Int                   @default(0)
  verified            Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ShoppingCart {
  id                  String                @id @default(cuid())
  userId              String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  items               CartItem[]

  @@unique([userId])
}

model CartItem {
  id                  String                @id @default(cuid())
  cartId              String
  productId           String
  quantity            Int
  addedAt             DateTime              @default(now())
  cart                ShoppingCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product             Product               @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                  String                @id @default(cuid())
  orderRef            String                @unique
  userId              String
  subtotal            Float
  tax                 Float
  shippingCost        Float                 @default(0)
  totalAmount         Float
  status              OrderStatus           @default(PENDING)
  paymentStatus       PaymentStatus         @default(PENDING)
  shippingAddress     String
  trackingNumber      String?
  estimatedDelivery   DateTime?
  notes               String?
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  items               OrderItem[]
  payments            Payment[]
}

model OrderItem {
  id                  String                @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  unitPrice           Float
  totalPrice          Float
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product               @relation(fields: [productId], references: [id])
}

enum UserRole {
  CUSTOMER
  DEALER
  INSPECTOR
  DRIVER
  ADMIN
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum VehicleCondition {
  NEW
  USED
  SALVAGE
  REBUILT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ImportQuoteStatus {
  REQUESTED
  QUOTED
  BOOKED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RentalVehicleStatus {
  AVAILABLE
  BOOKED
  IN_USE
  MAINTENANCE
  DAMAGED
  RETIRED
}

enum DamageLevel {
  MINOR
  MODERATE
  SEVERE
  TOTAL_LOSS
}

enum ProductCondition {
  NEW
  LIKE_NEW
  USED
  REFURBISHED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}
